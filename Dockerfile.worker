FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY geocadastra/ geocadastra/

# Only real difference from Dockerfile: celery worker instead of uvicorn,
# and no bootstrap step (the web service's own startup already owns that).
CMD celery -A geocadastra.jobs.orchestrator worker --loglevel=info --concurrency=2
